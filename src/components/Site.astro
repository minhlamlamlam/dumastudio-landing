---
interface Project {
  n: string;
  name: string;
  kind: string;
  href: string;
  visit: string;
  img: string;
  imgPos?: string;
  desc: string;
  tags: string[];
}

interface Strings {
  badge: string;
  h1a: string;
  h1b: string;
  intro: string[];
  pills: string[];
  workTitle1: string;
  workTitle2: string;
  workMeta: string;
  projects: Project[];
  ctaKicker: string;
  ctaTitle1: string;
  ctaTitle2: string;
  ctaText: string;
  work: string;
}

interface Props {
  lang: 'fr' | 'en';
  altHref: string;
  altLabel: string;
  t: Strings;
}

const { lang, altHref, altLabel, t } = Astro.props;
const marquee = ['Made to create.', 'Apps with attitude.', 'Hecho para crear.', 'Shipped for fun.'];
const marqueeItems = Array.from({ length: 4 }, () => marquee).flat();
---

<div class="duma">
  <header class="nav">
    <a href={lang === 'fr' ? '/' : '/en'} class="brand" aria-label="DU MA — App Studio">
      <img src="/duma-white.png" alt="DU MA App Studio" width="28" height="22" />
      <span class="mono">APP&nbsp;STUDIO</span>
    </a>
    <nav class="nav-links mono" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      <a href="#work">{t.work}</a>
      <a href={altHref} aria-label={`Switch to ${altLabel}`}>{altLabel}</a>
    </nav>
  </header>

  <section class="hero">
    <div class="hero-in" data-fx="heroout">
      <div class="hero-meta mono">
        <span>{t.badge}</span>
        <div class="pills">
          {t.pills.map((p) => <span class="pill">{p}</span>)}
        </div>
      </div>
      <h1>
        <span class="h1-line" data-fx="drift" data-s="-0.5">{t.h1a}</span>
        <span class="h1-line h1-acc" data-fx="drift" data-s="0.5">{t.h1b}</span>
      </h1>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track" data-fx="marquee" data-s="0.6">
      {marqueeItems.map((m) => <span>{m} •</span>)}
    </div>
  </div>

  <section class="intro">
    <p class="intro-text" data-scrub data-n={t.intro.length}>
      {t.intro.map((w, i) => (
        <span data-fx="word" data-i={i} class={i === 1 ? 'acc' : undefined}>{w} </span>
      ))}
    </p>
  </section>

  <section id="work" class="work">
    <div class="work-head">
      <h2>{t.workTitle1}<br />{t.workTitle2}</h2>
      <span class="mono work-meta">{t.workMeta}</span>
    </div>
    <div>
      {t.projects.map((p, i) => (
        <div class="stack-slot">
          <article class="card" data-fx="stack" style={`--c:var(--p${i + 1})`}>
            <div class="card-text">
              <div class="card-top mono"><span>{p.n}</span><span>{p.kind}</span></div>
              <div>
                <h3>{p.name}</h3>
                <p class="card-desc">{p.desc}</p>
              </div>
              <div class="card-foot mono">
                {p.tags.map((tag) => <span class="tag">{tag}</span>)}
                <a href={p.href} target="_blank" rel="noopener" class="visit">{p.visit} →</a>
              </div>
            </div>
            <div class="card-media">
              <img src={p.img} alt={p.name} loading="lazy" decoding="async" style={p.imgPos ? `object-position:${p.imgPos}` : undefined} />
            </div>
          </article>
        </div>
      ))}
    </div>
  </section>

  <section class="cta">
    <span class="mono cta-kicker">{t.ctaKicker}</span>
    <div><h2 data-fx="grow">{t.ctaTitle1}<br />{t.ctaTitle2}</h2></div>
    <p class="cta-text">{t.ctaText}</p>
  </section>

  <footer class="foot mono">
    <div class="foot-brand"><div class="foot-spin" data-fx="spin" data-s="0.3"></div><span>{t.badge}</span></div>
    <span>© {new Date().getFullYear()} DU MA APP STUDIO · TVA BE1028.727.857 · <a href="mailto:support@dumastudio.app" class="foot-mail">support@dumastudio.app</a></span>
  </footer>
</div>

<script>
  // Scroll-driven motion from the Claude Design "Kinetic" direction.
  const root = document.querySelector<HTMLElement>('.duma');
  if (root) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = Array.from(root.querySelectorAll<HTMLElement>('[data-fx]'));
    const cl = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const loop = () => {
      const vh = innerHeight, sy = scrollY, now = performance.now(), k = reduce ? 0 : 1;
      for (const el of els) {
        const s = parseFloat(el.dataset.s || '0') * k;
        const pr = () => el.parentElement!.getBoundingClientRect();
        let tf: string | null = null, op: number | null = null;
        switch (el.dataset.fx) {
          case 'drift': tf = `translateX(${sy * s}px)`; break;
          case 'heroout': { const t = reduce ? 0 : cl(sy / vh); op = 1 - t * 0.9; tf = `scale(${1 - t * 0.12})`; break; }
          case 'marquee': { const half = el.scrollWidth / 2; const x = ((now * 0.03 * k + sy * s) % half + half) % half; tf = `translateX(${-x}px)`; break; }
          case 'word': {
            const sc = el.closest<HTMLElement>('[data-scrub]')!; const r = sc.getBoundingClientRect();
            const p = reduce ? 1 : cl((vh * 0.85 - r.top) / (r.height + vh * 0.1));
            op = 0.14 + 0.86 * cl(p * +sc.dataset.n! - +el.dataset.i!); break;
          }
          case 'stack': {
            const nx = el.parentElement!.nextElementSibling;
            const t = nx && !reduce ? cl(1 - nx.getBoundingClientRect().top / vh) : 0;
            tf = `scale(${1 - t * 0.1})`; el.style.filter = `brightness(${1 - t * 0.5})`; break;
          }
          case 'grow': { const t = reduce ? 1 : cl((vh - pr().top) / (vh * 0.9)); tf = `scale(${0.5 + 0.5 * t})`; break; }
          case 'spin': tf = `rotate(${sy * s}deg)`; break;
        }
        if (tf !== null) el.style.transform = tf;
        if (op !== null) el.style.opacity = String(op);
      }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  }
</script>

<style>
  /* Palette "Nuit cobalt" */
  .duma {
    --dark: #11121C;
    --light: #EFEEF4;
    --muted: rgba(239, 238, 244, .6);
    --line: rgba(239, 238, 244, .15);
    --acc: oklch(0.82 0.15 65);
    --p1: oklch(0.79 0.12 20);
    --p2: oklch(0.79 0.12 290);
    --p3: oklch(0.79 0.12 175);
    background: var(--dark);
    color: var(--light);
    font-family: Archivo, -apple-system, BlinkMacSystemFont, sans-serif;
    min-height: 100vh;
    overflow-x: clip;
  }
  .duma h1, .duma h2, .duma h3, .duma p { margin: 0; }
  .duma a { color: inherit; text-decoration: none; transition: opacity .18s ease; }
  .duma a:hover { opacity: .75; }
  .mono { font-family: 'JetBrains Mono', monospace; font-weight: 600; letter-spacing: .12em; }

  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 20;
    display: flex; justify-content: space-between; align-items: center;
    padding: 22px 32px; mix-blend-mode: difference; color: #fff;
  }
  .brand { display: flex; align-items: center; gap: 12px; font-size: 11px; }
  .brand img { height: 22px; width: auto; display: block; }
  .nav-links { display: flex; gap: 28px; font-size: 11px; }

  .hero { height: 100vh; height: 100svh; position: relative; }
  .hero-in {
    position: sticky; top: 0; height: 100%;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 0 32px 48px; transform-origin: 50% 100%;
  }
  .hero-meta {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px;
    font-size: 11px; letter-spacing: .14em; color: var(--muted); margin-bottom: 28px;
  }
  .pills { display: flex; flex-wrap: wrap; gap: 8px; }
  .pill { border: 1px solid rgba(239, 238, 244, .3); border-radius: 99px; padding: 6px 12px; }
  .hero h1 {
    font-weight: 900; font-stretch: 62%; font-size: clamp(80px, 21vw, 380px);
    line-height: .8; letter-spacing: -.02em; text-transform: uppercase;
  }
  .h1-line { display: block; white-space: nowrap; }
  .h1-acc { color: var(--acc); text-align: right; }

  .marquee {
    position: relative; z-index: 2; background: var(--acc); color: var(--dark);
    transform: rotate(-2deg); margin: 12vh -40px 0; padding: 22px 0; overflow: hidden;
  }
  .marquee-track {
    display: flex; width: max-content; gap: 40px; font-weight: 900; font-stretch: 75%;
    font-size: clamp(28px, 4vw, 56px); text-transform: uppercase; white-space: nowrap;
  }

  .intro { position: relative; z-index: 2; background: var(--dark); padding: 28vh 32px 24vh; }
  .intro-text {
    max-width: 1200px; font-weight: 600; font-stretch: 88%; font-size: clamp(32px, 5.2vw, 84px);
    line-height: 1.02; letter-spacing: -.02em; text-wrap: pretty;
  }
  .acc { color: var(--acc); }

  .work { position: relative; z-index: 2; background: var(--dark); }
  .work-head {
    display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px;
    padding: 0 32px 24px; border-bottom: 1px solid var(--line);
  }
  .work-head h2 {
    font-weight: 900; font-stretch: 62%; font-size: clamp(48px, 8vw, 128px);
    line-height: .85; text-transform: uppercase;
  }
  .work-meta { font-size: 12px; color: var(--muted); }

  .stack-slot { position: sticky; top: 0; height: 100vh; height: 100svh; padding: 88px 24px 24px; }
  .card {
    height: 100%; border-radius: 28px; background: var(--c); color: var(--dark);
    padding: clamp(24px, 4vw, 56px); display: grid; grid-template-columns: 1fr 1fr; gap: 40px;
    transform-origin: 50% 0; overflow: hidden;
  }
  .card-text { display: flex; flex-direction: column; justify-content: space-between; gap: 24px; min-height: 0; }
  .card-top { display: flex; justify-content: space-between; font-size: 12px; }
  .card h3 {
    margin: 0 0 20px; font-weight: 900; font-stretch: 62%; font-size: clamp(64px, 10vw, 170px);
    line-height: .82; text-transform: uppercase;
  }
  .duma .card-desc { max-width: 460px; font-size: clamp(17px, 1.4vw, 22px); line-height: 1.4; font-weight: 500; }
  .card-foot { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 11px; letter-spacing: .1em; }
  .tag { border: 1.5px solid var(--dark); border-radius: 99px; padding: 7px 12px; }
  .visit { margin-left: auto; background: var(--dark); color: var(--light) !important; border-radius: 99px; padding: 12px 18px; }
  .card-media {
    position: relative; min-height: 240px; border-radius: 18px; overflow: hidden;
    background: repeating-linear-gradient(135deg, rgba(17, 18, 28, .1) 0 10px, transparent 10px 20px);
    border: 1.5px solid rgba(17, 18, 28, .25);
  }
  .card-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }

  .cta {
    position: relative; z-index: 2; background: var(--dark); min-height: 110vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; padding: 20vh 24px 10vh; overflow: hidden;
  }
  .cta-kicker { font-size: 12px; letter-spacing: .16em; color: var(--acc); margin-bottom: 24px; }
  .cta h2 {
    font-weight: 900; font-stretch: 62%; font-size: clamp(72px, 17vw, 300px);
    line-height: .82; text-transform: uppercase; white-space: nowrap;
  }
  .duma .cta-text { margin: 40px 0 0; max-width: 440px; font-size: 20px; line-height: 1.4; color: rgba(239, 238, 244, .75); }

  .foot {
    position: relative; z-index: 2; background: var(--dark); border-top: 1px solid var(--line);
    padding: 28px 32px; display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 20px; font-weight: 500; font-size: 11px; letter-spacing: .1em; color: var(--muted);
  }
  .foot-brand { display: flex; align-items: center; gap: 14px; }
  .foot-spin { width: 56px; height: 56px; border-radius: 50%; border: 1.5px dashed var(--acc); flex: none; }
  .foot-mail { color: var(--light); }

  ::selection { background: var(--acc); color: var(--dark); }

  @media (max-width: 820px) {
    .card { display: flex; flex-direction: column; gap: 20px; }
    .card-text { flex: none; }
    .card-media { flex: 1 1 0; min-height: 0; }
    .card h3 { font-size: clamp(44px, 14vw, 120px); margin-bottom: 14px; }
    .duma .card-desc { font-size: 16px; }
  }
  @media (max-width: 640px) {
    .nav { padding: 18px 20px; }
    .hero-in { padding: 0 20px 36px; }
    .hero h1 { font-size: 22vw; }
    .intro { padding-left: 20px; padding-right: 20px; }
    .work-head { padding-left: 20px; padding-right: 20px; }
    .stack-slot { padding: 76px 12px 12px; }
    .card { border-radius: 22px; }
    .visit { margin-left: 0; }
    .foot { padding: 24px 20px; }
  }
</style>
